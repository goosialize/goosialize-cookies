{% set cookie_config = config.plugins['goosialize-cookies'] %}
{% set policy_url = cookie_config.policy_url|default('') %}

{% set render = goosialize_cookies_render|default({}) %}
{% set render_active = render.active|default(false) %}
{% set render_banner = render.banner|default({}) %}
{% set render_buttons = render_banner.buttons|default({}) %}
{% set render_preferences = render.preferences|default({}) %}
{% set render_settings = render.settings_button|default({}) %}
{% set render_tablet = render.tablet|default({}) %}
{% set render_mobile = render.mobile|default({}) %}

{% set default_banner_title =
    'PLUGIN_GOOSIALIZE_COOKIES.UI.BANNER_TITLE'|t
%}

{% set default_banner_message =
    'PLUGIN_GOOSIALIZE_COOKIES.UI.BANNER_DESCRIPTION'|t
%}

{% set default_accept =
    'PLUGIN_GOOSIALIZE_COOKIES.UI.ACCEPT_ALL'|t
%}

{% set default_reject =
    'PLUGIN_GOOSIALIZE_COOKIES.UI.REJECT_ALL'|t
%}

{% set default_manage =
    'PLUGIN_GOOSIALIZE_COOKIES.UI.MANAGE_PREFERENCES'|t
%}

{% set default_settings =
    'PLUGIN_GOOSIALIZE_COOKIES.UI.COOKIE_SETTINGS'|t
%}

<div
    class="goo-consent"
    data-goosialize-consent-root
    data-saved-message="{{ 'PLUGIN_GOOSIALIZE_COOKIES.UI.SAVED'|t|e('html_attr') }}"
    data-banner-default-message="{{ 'PLUGIN_GOOSIALIZE_COOKIES.UI.BANNER_DESCRIPTION'|t|e('html_attr') }}"
    data-reconsent-expired-message="{{ 'PLUGIN_GOOSIALIZE_COOKIES.UI.RECONSENT_EXPIRED'|t|e('html_attr') }}"
    data-reconsent-version-message="{{ 'PLUGIN_GOOSIALIZE_COOKIES.UI.RECONSENT_VERSION_CHANGED'|t|e('html_attr') }}"
    {% if render_active %}
        data-goosialize-presentation="appearance"
        data-goosialize-banner-mode="{{ render_banner.mode|e('html_attr') }}"
        data-goosialize-effective-banner-mode="{{ render_banner.mode|e('html_attr') }}"
        data-goosialize-banner-position="{{ render_banner.position|e('html_attr') }}"
        data-goosialize-banner-content-alignment="{{ render_banner.content_alignment|e('html_attr') }}"
        data-goosialize-effective-content-alignment="{{ render_banner.content_alignment|e('html_attr') }}"
        data-goosialize-button-layout="{{ render_buttons.layout|e('html_attr') }}"
        data-goosialize-button-alignment="{{ render_buttons.alignment|e('html_attr') }}"
        data-goosialize-effective-stack-buttons="false"
        data-goosialize-effective-full-width="false"
        data-goosialize-preferences-backdrop="{{ render_preferences.backdrop_enabled ? 'true' : 'false' }}"
        data-goosialize-preferences-sticky-footer="{{ render_preferences.sticky_footer ? 'true' : 'false' }}"
        data-goosialize-toggle-style="{{ render_preferences.toggles.style|e('html_attr') }}"
        data-goosialize-settings-position="{{ render_settings.position|e('html_attr') }}"
        data-goosialize-tablet-breakpoint="{{ render_tablet.breakpoint }}"
        data-goosialize-tablet-banner-mode="{{ render_tablet.banner_mode|e('html_attr') }}"
        data-goosialize-tablet-full-width="{{ render_tablet.full_width ? 'true' : 'false' }}"
        data-goosialize-tablet-edge-spacing="{{ render_tablet.edge_spacing }}"
        data-goosialize-tablet-stack-buttons="{{ render_tablet.stack_buttons ? 'true' : 'false' }}"
        data-goosialize-tablet-content-alignment="{{ render_tablet.content_alignment|e('html_attr') }}"
        data-goosialize-mobile-breakpoint="{{ render_mobile.breakpoint }}"
        data-goosialize-mobile-banner-mode="{{ render_mobile.banner_mode|e('html_attr') }}"
        data-goosialize-mobile-full-width="{{ render_mobile.full_width ? 'true' : 'false' }}"
        data-goosialize-mobile-edge-spacing="{{ render_mobile.edge_spacing }}"
        data-goosialize-mobile-stack-buttons="{{ render_mobile.stack_buttons ? 'true' : 'false' }}"
        data-goosialize-mobile-content-alignment="{{ render_mobile.content_alignment|e('html_attr') }}"
        style="{{ render.style|e('html_attr') }}"
    {% endif %}
>
    <section
        class="goo-consent__banner"
        data-goosialize-consent-banner
        aria-labelledby="goo-consent-banner-title"
        aria-describedby="goo-consent-banner-description"
        hidden
    >
        <div class="goo-consent__surface">
            <div class="goo-consent__copy">
                <h2
                    class="goo-consent__title"
                    id="goo-consent-banner-title"
                >
                    {{ render_banner.content.title|default(default_banner_title, true)|e }}
                </h2>

                <p
                    class="goo-consent__description"
                    id="goo-consent-banner-description"
                    data-goosialize-consent-banner-description
                >
                    {{ render_banner.content.message|default(default_banner_message, true)|e }}
                </p>

                {% if policy_url %}
                    <a
                        class="goo-consent__policy"
                        href="{{ policy_url|e('html_attr') }}"
                    >
                        {{ 'PLUGIN_GOOSIALIZE_COOKIES.UI.PRIVACY_POLICY'|t|e }}
                    </a>
                {% endif %}
            </div>

            <div
                class="goo-consent__actions"
                aria-label="{{ 'PLUGIN_GOOSIALIZE_COOKIES.UI.BANNER_TITLE'|t|e('html_attr') }}"
            >
                <button
                    type="button"
                    class="goo-consent__button goo-consent__button--choice"
                    data-goosialize-consent-action="accept-all"
                >
                    {{ render_buttons.accept.label|default(default_accept, true)|e }}
                </button>

                <button
                    type="button"
                    class="goo-consent__button goo-consent__button--choice"
                    data-goosialize-consent-action="reject-all"
                >
                    {{ render_buttons.reject.label|default(default_reject, true)|e }}
                </button>

                <button
                    type="button"
                    class="goo-consent__button goo-consent__button--secondary"
                    data-goosialize-consent-action="manage"
                >
                    {{ render_buttons.customize.label|default(default_manage, true)|e }}
                </button>
            </div>
        </div>
    </section>

    <div
        class="goo-consent__backdrop"
        data-goosialize-consent-backdrop
        hidden
    >
        <section
            class="goo-consent__modal"
            data-goosialize-consent-modal
            role="dialog"
            aria-modal="true"
            aria-labelledby="goo-consent-modal-title"
            aria-describedby="goo-consent-modal-description"
            tabindex="-1"
        >
            <header class="goo-consent__modal-header">
                <div>
                    <h2
                        class="goo-consent__title"
                        id="goo-consent-modal-title"
                    >
                        {{ 'PLUGIN_GOOSIALIZE_COOKIES.UI.PREFERENCES_TITLE'|t|e }}
                    </h2>

                    <p
                        class="goo-consent__description"
                        id="goo-consent-modal-description"
                    >
                        {{ 'PLUGIN_GOOSIALIZE_COOKIES.UI.PREFERENCES_DESCRIPTION'|t|e }}
                    </p>
                </div>

                <button
                    type="button"
                    class="goo-consent__close"
                    data-goosialize-consent-action="close"
                    aria-label="{{ 'PLUGIN_GOOSIALIZE_COOKIES.UI.CLOSE'|t|e('html_attr') }}"
                >
                    <span aria-hidden="true">×</span>
                </button>
            </header>

            <div class="goo-consent__categories">
                <article class="goo-consent__category">
                    <div class="goo-consent__category-copy">
                        <h3 class="goo-consent__category-title">
                            {{ 'PLUGIN_GOOSIALIZE_COOKIES.CATEGORY.NECESSARY.TITLE'|t|e }}
                        </h3>

                        <p class="goo-consent__category-description">
                            {{ 'PLUGIN_GOOSIALIZE_COOKIES.CATEGORY.NECESSARY.DESCRIPTION'|t|e }}
                        </p>
                    </div>

                    <div class="goo-consent__category-control">
                        <span class="goo-consent__required">
                            {{ 'PLUGIN_GOOSIALIZE_COOKIES.UI.ALWAYS_ACTIVE'|t|e }}
                        </span>

                        <input
                            type="checkbox"
                            checked
                            disabled
                            aria-label="{{ 'PLUGIN_GOOSIALIZE_COOKIES.CATEGORY.NECESSARY.TITLE'|t|e('html_attr') }}"
                        >
                    </div>

                    {% include
                        'partials/goosialize-cookies-service-disclosure.html.twig'
                        with {
                            category: 'necessary'
                        }
                    %}
                </article>

                {% for category in ['preferences', 'analytics', 'marketing'] %}
                    {% set key = category|upper %}

                    <article class="goo-consent__category">
                        <div class="goo-consent__category-copy">
                            <h3 class="goo-consent__category-title">
                                {% if category == 'preferences' %}
                                    {{ 'PLUGIN_GOOSIALIZE_COOKIES.CATEGORY.PREFERENCES.TITLE'|t|e }}
                                {% elseif category == 'analytics' %}
                                    {{ 'PLUGIN_GOOSIALIZE_COOKIES.CATEGORY.ANALYTICS.TITLE'|t|e }}
                                {% else %}
                                    {{ 'PLUGIN_GOOSIALIZE_COOKIES.CATEGORY.MARKETING.TITLE'|t|e }}
                                {% endif %}
                            </h3>

                            <p class="goo-consent__category-description">
                                {% if category == 'preferences' %}
                                    {{ 'PLUGIN_GOOSIALIZE_COOKIES.CATEGORY.PREFERENCES.DESCRIPTION'|t|e }}
                                {% elseif category == 'analytics' %}
                                    {{ 'PLUGIN_GOOSIALIZE_COOKIES.CATEGORY.ANALYTICS.DESCRIPTION'|t|e }}
                                {% else %}
                                    {{ 'PLUGIN_GOOSIALIZE_COOKIES.CATEGORY.MARKETING.DESCRIPTION'|t|e }}
                                {% endif %}
                            </p>
                        </div>

                        <label class="goo-consent__toggle">
                            <span class="goo-consent__sr-only">
                                {% if category == 'preferences' %}
                                    {{ 'PLUGIN_GOOSIALIZE_COOKIES.CATEGORY.PREFERENCES.TITLE'|t|e }}
                                {% elseif category == 'analytics' %}
                                    {{ 'PLUGIN_GOOSIALIZE_COOKIES.CATEGORY.ANALYTICS.TITLE'|t|e }}
                                {% else %}
                                    {{ 'PLUGIN_GOOSIALIZE_COOKIES.CATEGORY.MARKETING.TITLE'|t|e }}
                                {% endif %}
                            </span>

                            <input
                                type="checkbox"
                                data-goosialize-consent-category="{{ category }}"
                            >

                            <span
                                class="goo-consent__toggle-track"
                                aria-hidden="true"
                            >
                                <span class="goo-consent__toggle-thumb"></span>
                            </span>
                        </label>

                        {% include
                            'partials/goosialize-cookies-service-disclosure.html.twig'
                            with {
                                category: category
                            }
                        %}
                    </article>
                {% endfor %}
            </div>

            {% if policy_url %}
                <a
                    class="goo-consent__policy goo-consent__modal-policy"
                    href="{{ policy_url|e('html_attr') }}"
                >
                    {{ 'PLUGIN_GOOSIALIZE_COOKIES.UI.PRIVACY_POLICY'|t|e }}
                </a>
            {% endif %}

            <footer class="goo-consent__modal-actions">
                <button
                    type="button"
                    class="goo-consent__button goo-consent__button--choice"
                    data-goosialize-consent-action="save"
                >
                    {{ 'PLUGIN_GOOSIALIZE_COOKIES.UI.SAVE_PREFERENCES'|t|e }}
                </button>

                <button
                    type="button"
                    class="goo-consent__button goo-consent__button--choice"
                    data-goosialize-consent-action="reject-all"
                >
                    {{ render_buttons.reject.label|default(default_reject, true)|e }}
                </button>

                <button
                    type="button"
                    class="goo-consent__button goo-consent__button--choice"
                    data-goosialize-consent-action="accept-all"
                >
                    {{ render_buttons.accept.label|default(default_accept, true)|e }}
                </button>
            </footer>
        </section>
    </div>

    <button
        type="button"
        class="goo-consent__settings"
        data-goosialize-consent-action="manage"
        data-goosialize-consent-settings
        hidden
    >
        {{ render_settings.label|default(default_settings, true)|e }}
    </button>

    <div
        class="goo-consent__sr-only"
        role="status"
        aria-live="polite"
        data-goosialize-consent-status
    ></div>
</div>

{% include 'partials/goosialize-cookies-runtime.html.twig' %}
